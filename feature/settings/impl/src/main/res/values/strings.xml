    <string name="feature_settings_impl_profile_about_body">A read-only Wikipedia client built on Now in Android. Sign-in and membership are not part of this version.</string>
    <string name="feature_settings_impl_about_app_name">Wikipedia reader</string>
    <string name="feature_settings_impl_about_unofficial">This app is an unofficial, read-only Wikipedia client. It is not affiliated with, endorsed by, or sponsored by the Wikimedia Foundation or Wikipedia.</string>
