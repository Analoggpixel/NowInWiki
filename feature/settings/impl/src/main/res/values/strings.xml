    <string name="feature_settings_impl_about_privacy">Privacy</string>
    <string name="feature_settings_impl_about_privacy_body">This app stores preferences, bookmarks, search history, and reading history on your device. It requests Wikipedia content over the network when you search or open articles.\n\nThis version does not require an account and does not intentionally upload your reading history or bookmarks to a third-party backend operated by this app.</string>
    <string name="feature_settings_impl_about_open_source">Open source</string>
    <string name="feature_settings_impl_about_open_source_body">This project is based on Now in Android and is distributed under the Apache License 2.0. Wikipedia article content remains under its own licenses (typically CC BY-SA).</string>
