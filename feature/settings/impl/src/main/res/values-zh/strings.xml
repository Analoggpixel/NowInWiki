    <string name="feature_settings_impl_profile_about">关于</string>
    <string name="feature_settings_impl_profile_about_body">这是一个基于 Now in Android 的维基百科只读客户端。当前版本不提供登录与会员。</string>
    <string name="feature_settings_impl_about_app_name">Now in Wiki</string>
    <string name="feature_settings_impl_about_unofficial">本应用是非官方的维基百科只读客户端，与 Wikimedia Foundation、维基百科无隶属、背书或赞助关系。</string>
    <string name="feature_settings_impl_about_content_license">内容许可</string>
    <string name="feature_settings_impl_about_content_license_summary">CC BY-SA</string>
    <string name="feature_settings_impl_about_content_license_body">应用内展示的词条正文来自维基百科 / MediaWiki，通常以知识共享署名–相同方式共享（CC BY-SA）许可提供。请按许可要求署名，并以各页面标注为准。\n\n使用本应用不改变维基百科内容的许可条款。「Wikipedia」「Wikimedia」等为相关权利人的商标。</string>
    <string name="feature_settings_impl_about_content_license_link">查看 CC BY-SA</string>
    <string name="feature_settings_impl_about_privacy">隐私说明</string>
    <string name="feature_settings_impl_about_privacy_body">本应用会在本机保存偏好设置、收藏、搜索记录与浏览记录。当你搜索或打开词条时，会联网请求维基百科内容。\n\n当前版本无需账号，也不会把你的浏览记录或收藏主动上传到本应用自有的第三方服务器。</string>
    <string name="feature_settings_impl_about_open_source">开源说明</string>
    <string name="feature_settings_impl_about_open_source_body">本项目基于 Now in Android，源代码以 Apache License 2.0 分发。维基百科词条内容仍适用其自身许可（通常为 CC BY-SA）。</string>
    <string name="feature_settings_impl_about_nia_link">Now in Android</string>
